{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DiegoRugue/GarageFlow/main/contracts/infra-contract-v1.schema.json",
  "title": "GarageFlow Infrastructure Metadata Contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "environment",
    "producer",
    "sourceCommit",
    "publishedAt",
    "outputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "environment": {
      "enum": [
        "homologation",
        "production"
      ]
    },
    "producer": {
      "enum": [
        "platform",
        "database",
        "ingress",
        "serverless"
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "outputs": {
      "type": "object"
    }
  },
  "propertyNames": {
    "$ref": "#/$defs/safeFieldName"
  },
  "additionalProperties": {
    "$ref": "#/$defs/publicMetadata"
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "producer": {
            "const": "platform"
          }
        },
        "required": [
          "producer"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "$ref": "#/$defs/platformOutputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer": {
            "const": "database"
          }
        },
        "required": [
          "producer"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "$ref": "#/$defs/databaseOutputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer": {
            "const": "ingress"
          }
        },
        "required": [
          "producer"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "$ref": "#/$defs/ingressOutputs"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer": {
            "const": "serverless"
          }
        },
        "required": [
          "producer"
        ]
      },
      "then": {
        "properties": {
          "outputs": {
            "$ref": "#/$defs/serverlessOutputs"
          }
        }
      }
    }
  ],
  "$defs": {
    "safeFieldName": {
      "allOf": [
        {
          "not": {
            "pattern": "[Pp][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Ss][^A-Za-z0-9]*[Ss][^A-Za-z0-9]*(?:[Ww][^A-Za-z0-9]*[Oo][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Dd]|[Pp][^A-Za-z0-9]*[Hh][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Ss][^A-Za-z0-9]*[Ee]|[Ww][^A-Za-z0-9]*[Dd])"
          }
        },
        {
          "not": {
            "pattern": "[Tt][^A-Za-z0-9]*[Oo][^A-Za-z0-9]*[Kk][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Nn]"
          }
        },
        {
          "not": {
            "pattern": "[Ss][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Cc][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Tt]"
          }
        },
        {
          "not": {
            "pattern": "[Cc][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Dd][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Nn][^A-Za-z0-9]*[Tt][^A-Za-z0-9]*[Ii][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Ll]"
          }
        },
        {
          "not": {
            "pattern": "(?:[Pp][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Ii][^A-Za-z0-9]*[Vv][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Tt][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*(?:[Kk][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Yy]|[Pp][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Mm])|[Pp][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Mm][^A-Za-z0-9]*[Pp][^A-Za-z0-9]*[Rr][^A-Za-z0-9]*[Ii][^A-Za-z0-9]*[Vv][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Tt][^A-Za-z0-9]*[Ee])"
          }
        },
        {
          "not": {
            "pattern": "(?:[Aa][^A-Za-z0-9]*[Pp][^A-Za-z0-9]*[Ii]|[Aa][^A-Za-z0-9]*[Cc][^A-Za-z0-9]*[Cc][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Ss][^A-Za-z0-9]*[Ss])[^A-Za-z0-9]*[Kk][^A-Za-z0-9]*[Ee][^A-Za-z0-9]*[Yy]"
          }
        },
        {
          "not": {
            "pattern": "[Hh][^A-Za-z0-9]*[Aa][^A-Za-z0-9]*[Ss][^A-Za-z0-9]*[Hh]"
          }
        }
      ]
    },
    "platformOutputFieldName": {
      "anyOf": [
        {
          "enum": [
            "jwtSecretArn",
            "internalAuthSecretArn",
            "bootstrapSecretArn",
            "webhookSecretArn"
          ]
        },
        {
          "$ref": "#/$defs/safeFieldName"
        }
      ]
    },
    "databaseOutputFieldName": {
      "anyOf": [
        {
          "const": "databaseSecretArn"
        },
        {
          "$ref": "#/$defs/safeFieldName"
        }
      ]
    },
    "publicMetadata": {
      "anyOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicMetadata"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/safeFieldName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/publicMetadata"
          }
        }
      ]
    },
    "nonEmptyCleanString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    },
    "arn": {
      "allOf": [
        {
          "$ref": "#/$defs/nonEmptyCleanString"
        },
        {
          "pattern": "^arn:aws(?:-us-gov|-cn)?:[a-z0-9-]+:[a-z0-9-]*:[0-9]{12}:\\S+$"
        }
      ]
    },
    "subnetIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^subnet-[0-9a-f]{8}(?:[0-9a-f]{9})?$"
      }
    },
    "platformOutputs": {
      "type": "object",
      "required": [
        "awsRegion",
        "vpcId",
        "publicSubnetIds",
        "privateApplicationSubnetIds",
        "databaseSubnetIds",
        "clusterName",
        "clusterSecurityGroupId",
        "ecrRepositoryUrl",
        "apiGatewayId",
        "apiGatewayExecutionArn",
        "jwtSecretArn",
        "internalAuthSecretArn",
        "bootstrapSecretArn",
        "webhookSecretArn",
        "snsTopicArn"
      ],
      "properties": {
        "awsRegion": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$"
        },
        "vpcId": {
          "type": "string",
          "pattern": "^vpc-[0-9a-f]{8}(?:[0-9a-f]{9})?$"
        },
        "publicSubnetIds": {
          "$ref": "#/$defs/subnetIds"
        },
        "privateApplicationSubnetIds": {
          "$ref": "#/$defs/subnetIds"
        },
        "databaseSubnetIds": {
          "$ref": "#/$defs/subnetIds"
        },
        "clusterName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
        },
        "clusterSecurityGroupId": {
          "type": "string",
          "pattern": "^sg-[0-9a-f]{8}(?:[0-9a-f]{9})?$"
        },
        "ecrRepositoryUrl": {
          "type": "string",
          "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com(?:\\.cn)?/[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
        },
        "apiGatewayId": {
          "type": "string",
          "pattern": "^[a-z0-9]{10}$"
        },
        "apiGatewayExecutionArn": {
          "allOf": [
            {
              "$ref": "#/$defs/arn"
            },
            {
              "pattern": "^arn:aws(?:-us-gov|-cn)?:execute-api:[a-z0-9-]+:[0-9]{12}:[a-z0-9]{10}$"
            }
          ]
        },
        "jwtSecretArn": {
          "$ref": "#/$defs/secretArn"
        },
        "internalAuthSecretArn": {
          "$ref": "#/$defs/secretArn"
        },
        "bootstrapSecretArn": {
          "$ref": "#/$defs/secretArn"
        },
        "webhookSecretArn": {
          "$ref": "#/$defs/secretArn"
        },
        "snsTopicArn": {
          "allOf": [
            {
              "$ref": "#/$defs/arn"
            },
            {
              "pattern": "^arn:aws(?:-us-gov|-cn)?:sns:[a-z0-9-]+:[0-9]{12}:\\S+$"
            }
          ]
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/platformOutputFieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/publicMetadata"
      }
    },
    "databaseOutputs": {
      "type": "object",
      "required": [
        "databaseHost",
        "databasePort",
        "databaseName",
        "databaseSecretArn",
        "databaseSecurityGroupId"
      ],
      "properties": {
        "databaseHost": {
          "type": "string",
          "format": "hostname"
        },
        "databasePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "databaseName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,62}$"
        },
        "databaseSecretArn": {
          "$ref": "#/$defs/secretArn"
        },
        "databaseSecurityGroupId": {
          "type": "string",
          "pattern": "^sg-[0-9a-f]{8}(?:[0-9a-f]{9})?$"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/databaseOutputFieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/publicMetadata"
      }
    },
    "ingressOutputs": {
      "type": "object",
      "required": [
        "listenerArn",
        "internalApiBaseUrl",
        "tlsServerName"
      ],
      "properties": {
        "listenerArn": {
          "allOf": [
            {
              "$ref": "#/$defs/arn"
            },
            {
              "pattern": "^arn:aws(?:-us-gov|-cn)?:elasticloadbalancing:[a-z0-9-]+:[0-9]{12}:listener/\\S+$"
            }
          ]
        },
        "internalApiBaseUrl": {
          "$ref": "#/$defs/nonEmptyCleanString",
          "format": "uri",
          "description": "HTTPS base URL with a hostname of at most 253 characters, the default HTTPS port, and no credentials, non-root path, query value, or fragment value.",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?=[^:/?#]{1,253}(?:[:/?#]|$))[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+(?::(?:0*443)?)?/?\\??#?$"
        },
        "tlsServerName": {
          "type": "string",
          "format": "hostname"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/safeFieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/publicMetadata"
      }
    },
    "serverlessOutputs": {
      "type": "object",
      "required": [
        "customerAuthenticationAliasArn",
        "requestAuthorizerAliasArn"
      ],
      "properties": {
        "customerAuthenticationAliasArn": {
          "$ref": "#/$defs/lambdaAliasArn"
        },
        "requestAuthorizerAliasArn": {
          "$ref": "#/$defs/lambdaAliasArn"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/safeFieldName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/publicMetadata"
      }
    },
    "secretArn": {
      "allOf": [
        {
          "$ref": "#/$defs/arn"
        },
        {
          "pattern": "^arn:aws(?:-us-gov|-cn)?:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:\\S+$"
        }
      ]
    },
    "lambdaAliasArn": {
      "allOf": [
        {
          "$ref": "#/$defs/arn"
        },
        {
          "pattern": "^arn:aws(?:-us-gov|-cn)?:lambda:[a-z0-9-]+:[0-9]{12}:function:[A-Za-z0-9_-]{1,64}:(?![0-9]+$)[A-Za-z0-9_-]{1,128}$"
        }
      ]
    }
  }
}
